@model mvc_btap04.Models.SinhVien

@{
    ViewData["Title"] = "Sửa Thông Tin Sinh Viên";
}

<h2 class="my-4">Sửa Thông Tin Sinh Viên</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <div class="form-group mb-3">
                <label class="control-label">Mã Sinh Viên</label>
                <input asp-for="MaSv" class="form-control" required />
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Họ và Tên</label>
                <input asp-for="HoTen" class="form-control" required />
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Ngày Sinh</label>
                <input asp-for="NgaySinh" class="form-control" type="date" required />
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Email</label>
                <input asp-for="Email" class="form-control" type="email" />
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Lớp Học</label>
                <input asp-for="LopHoc" class="form-control" />
            </div>
            <div class="form-group">
                <input type="submit" value="Cập nhật" class="btn btn-warning" />
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>